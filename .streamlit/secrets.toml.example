# Copy these into Streamlit Cloud: your app -> Settings -> Secrets.
# For local testing you can copy this file to .streamlit/secrets.toml (never commit that file).

# Signs participants' sessions. Generate one with:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY = "paste-a-long-random-string"

# Password for the researcher page (/admin, reached from the site's own admin link).
ADMIN_SECRET = "choose-a-researcher-password"

# Supabase Storage: keeps participants' Excel files safe when Streamlit restarts the app.
SUPABASE_URL = "https://YOUR-PROJECT-ID.supabase.co"
SUPABASE_KEY = "your-service_role-key"
SUPABASE_BUCKET = "annotations"
